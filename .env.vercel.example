# ============================================================
# FindIt Campus — Vercel Environment Variables
# Copy these to your Vercel project settings under:
# Project → Settings → Environment Variables
# ============================================================

# ---------- Flask ----------
FLASK_ENV=production
SECRET_KEY=your-strong-secret-key-here

# ---------- Database (Neon PostgreSQL — Free) ----------
# Get this from: https://neon.tech → Create Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/findit_campus?sslmode=require

# ---------- JWT ----------
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# ---------- Mail (Gmail SMTP) ----------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=finditcampus@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=FindIt Campus <finditcampus@gmail.com>

# ---------- Cloudinary (for image uploads) ----------
# Get this from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- CORS ----------
# Replace with your actual Vercel URL after first deploy
CORS_ORIGINS=https://your-project.vercel.app
